{
    "name": "nextjs-boilerplate",
    "version": "16.4.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "next typegen && tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:generators": "node scripts/test-generators.mjs",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:generators && npm run build"
    },
    "dependencies": {
        "next": "16.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "typescript": "6.0.3",
        "hygen": "6.2.11",
        "prettier": "3.9.9",
        "sass-embedded": "1.105.1",
        "eslint": "10.12.0",
        "eslint-config-next": "16.4.0",
        "eslint-config-prettier": "10.1.8",
        "sass": "1.105.1"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
